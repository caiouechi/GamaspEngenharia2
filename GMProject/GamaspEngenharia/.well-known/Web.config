<?xml version="1.0" encoding="utf-8"?>
<!--
  Let's Encrypt / ACME

  A validação do certificado pede /.well-known/acme-challenge/<token>.
  O token é um arquivo SEM extensão, e por padrão o IIS entrega URLs sem
  extensão ao ASP.NET, que tenta roteá-las e responde 404 — a emissão
  do certificado falha.

  Este Web.config vale apenas para esta pasta: tira os handlers do
  ASP.NET do caminho e serve o arquivo como texto puro. O resto do site
  continua exatamente como está.

  (Não dá para fazer isso com <location path=".well-known"> no Web.config
  principal: o IIS recusa path começando com ponto.)
-->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
      <add name="ArquivoEstatico" path="*" verb="GET,HEAD" modules="StaticFileModule"
           resourceType="Either" requireAccess="Read" />
    </handlers>
    <staticContent>
      <clear />
      <mimeMap fileExtension="." mimeType="text/plain" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".txt" mimeType="text/plain" />
    </staticContent>
    <directoryBrowse enabled="false" />
  </system.webServer>
  <system.web>
    <!-- o desafio precisa ser público para a autoridade certificadora -->
    <authorization>
      <allow users="*" />
    </authorization>
  </system.web>
</configuration>
