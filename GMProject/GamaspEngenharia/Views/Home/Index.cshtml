@{
    ViewBag.Title = null;
    ViewBag.Descricao = "Gamasp Engenharia: regularização de imóveis, gerenciamento de obras, projetos aprovados em prefeitura, AVCB, SPDA, NRs e retrofit de fachadas em São Paulo. Responsável técnico com CREA. Orçamento pelo WhatsApp.";
    var wa = "https://api.whatsapp.com/send?phone=5511947430418&text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20Gamasp%20Engenharia%20e%20gostaria%20de%20solicitar%20um%20or%C3%A7amento.";
}

<!-- ============================ HERO ============================ -->
<section class="hero">
    <div class="hero-media">
        <img src="~/images/gamasp/hero-obra-xl.jpg"
             srcset="@Url.Content("~/images/gamasp/hero-obra-w.jpg") 1600w, @Url.Content("~/images/gamasp/hero-obra-xl.jpg") 2400w, @Url.Content("~/images/gamasp/hero-obra.jpg") 5504w"
             sizes="100vw"
             alt="Edifício em construção em São Paulo ao pôr do sol" fetchpriority="high" />
    </div>
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="shell">
        <div class="hero-inner">
            <span class="hero-badge reveal"><b>✓</b> Responsável técnico com CREA ativo</span>

            <h1 class="reveal" data-d="1">
                Engenharia que <em>entrega</em>.<br />
                Do projeto ao Habite-se.
            </h1>

            <p class="hero-sub reveal" data-d="2">
                Há mais de uma década resolvendo o que trava a sua obra em São Paulo: regularização,
                aprovação em prefeitura, gestão de canteiro, laudos e segurança. Prazo combinado é prazo cumprido.
            </p>

            <div class="hero-actions reveal" data-d="3">
                <a class="btn btn--lg" href="@wa" target="_blank" rel="noopener">
                    Solicitar orçamento agora
                    <span class="btn-arrow">→</span>
                </a>
                <a class="btn btn--ghost btn--lg" href="@Url.Action("Servicos", "Home")">
                    Ver todos os serviços
                    <span class="btn-arrow">→</span>
                </a>
            </div>

            <div class="hero-trust reveal" data-d="4">
                <div><strong><i>+</i><span data-count="12">0</span></strong> anos de atuação</div>
                <div><strong><span data-count="480">0</span><i>+</i></strong> processos e obras</div>
                <div><strong><span data-count="8">0</span></strong> frentes de serviço</div>
                <div><strong>CREA</strong> 2223278</div>
            </div>
        </div>
    </div>

    <a href="#sobre" class="hero-scroll" aria-label="Rolar para o conteúdo">
        <span>Role</span>
        <i></i>
    </a>
</section>

<!-- ==================== Faixa de credenciais ==================== -->
