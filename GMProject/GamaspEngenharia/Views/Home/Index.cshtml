    <div class="marquee-track">
        <div class="marquee-group">
            <span>Regularização de Imóveis</span>
            <span>Usucapião</span>
            <span>Habite-se</span>
            <span>AVCB / PPCI</span>
            <span>SPDA · NBR 5419</span>
            <span>Gerenciamento de Obras</span>
            <span>Laudos e Perícias</span>
            <span>Retrofit de Fachadas</span>
            <span>NR-10 · NR-12 · NR-18 · NR-35</span>
        </div>
        <div class="marquee-group">
            <span>Regularização de Imóveis</span>
            <span>Usucapião</span>
            <span>Habite-se</span>
            <span>AVCB / PPCI</span>
            <span>SPDA · NBR 5419</span>
            <span>Gerenciamento de Obras</span>
            <span>Laudos e Perícias</span>
            <span>Retrofit de Fachadas</span>
            <span>NR-10 · NR-12 · NR-18 · NR-35</span>
        </div>
