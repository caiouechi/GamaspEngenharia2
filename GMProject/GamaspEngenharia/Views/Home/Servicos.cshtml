<!-- ============================ LISTA DE SERVIÇOS ============================ -->
@{ var alterna = false; }
@foreach (var s in lista)
{
    alterna = !alterna;
    <section class="section @(alterna ? "section--bone" : "section--paper")" id="@s.Id">
        <div class="shell">
            <div class="split split--imersivo @(alterna ? "" : "split--reverse")">
                <div class="split-media reveal">
                    <div class="frame-offset">
                        <div class="frame">
                            <img src="~/images/gamasp/@(s.Img)-w.jpg"
                                 srcset="@Url.Content("~/images/gamasp/" + s.Img + "-w.jpg") 1600w, @Url.Content("~/images/gamasp/" + s.Img + "-xl.jpg") 2400w"
                                 sizes="(min-width: 981px) 58vw, 100vw"
                                 alt="@s.Titulo" loading="lazy" />
                        </div>
                        <div class="stat-badge">
                            <strong>@s.Num</strong>
                            <span>serviço</span>
                        </div>
                    </div>
                </div>

                <div class="reveal" data-d="2">
                    <span class="eyebrow">Serviço @s.Num</span>
                    <h2>@s.Titulo</h2>
                    <p class="lead">@s.Chamada</p>

                    <h3 style="font-size:1.02rem;margin-top:32px;margin-bottom:4px;">O que está incluído</h3>
                    <ul class="ticks">
                        @foreach (var item in s.Oferecemos)
                        {
                            <li>@item</li>
                        }
                    </ul>

                    <h3 style="font-size:1.02rem;margin-bottom:4px;">Por que contratar a Gamasp</h3>
                    <ul class="ticks">
                        @foreach (var item in s.PorQue)
                        {
                            <li>@item</li>
                        }
                    </ul>

                    <p style="font-family:var(--font-display);font-weight:600;color:var(--amber-deep);margin-bottom:26px;">
                        @s.Fecho
                    </p>

                    <a class="btn" href="@wa" target="_blank" rel="noopener">
                        Pedir orçamento deste serviço
                        <span class="btn-arrow">→</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
}

<!-- ============================ CTA ============================ -->
<section class="section cta">
    <div class="cta-media">
        <img src="~/images/gamasp/parceria-w.jpg"
             srcset="@Url.Content("~/images/gamasp/parceria-w.jpg") 1600w, @Url.Content("~/images/gamasp/parceria-xl.jpg") 2400w"
             sizes="100vw" alt="" aria-hidden="true" loading="lazy"  />
    </div>
    <div class="shell">
        <div class="cta-inner">
            <div class="reveal">
                <span class="eyebrow">Não encontrou o que precisa?</span>
                <h2>Descreva a sua necessidade. A gente diz se é com a gente.</h2>
                <p>Atuamos em engenharia civil, segurança do trabalho, avaliações e perícias. Se o serviço não for nosso, indicamos quem faz — com honestidade.</p>
            </div>
            <div class="cta-actions reveal" data-d="2">
                <a class="btn btn--lg" href="@wa" target="_blank" rel="noopener">
                    Chamar no WhatsApp
                    <span class="btn-arrow">→</span>
                </a>
                <a class="btn btn--ghost btn--lg" href="@Url.Action("FaleConosco", "Home")">
                    Enviar mensagem
                    <span class="btn-arrow">→</span>
                </a>
            </div>
        </div>
    </div>
</section>
