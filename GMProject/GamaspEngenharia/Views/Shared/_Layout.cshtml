@{
    var waNumero = "5511947430418";
    var waTexto = "Ol%C3%A1!%20Vim%20pelo%20site%20da%20Gama%20SP%20Engenharia%20e%20gostaria%20de%20solicitar%20um%20or%C3%A7amento.";
    var waLink = "https://api.whatsapp.com/send?phone=" + waNumero + "&text=" + waTexto;
    // Base real do site (funciona na raiz e em subpasta/alias do IIS)
    var urlBase = new Uri(Request.Url, Url.Content("~/")).AbsoluteUri.TrimEnd('/');
    var urlAtual = new Uri(Request.Url, Request.RawUrl).GetLeftPart(UriPartial.Path);
    var acaoAtual = (ViewContext.RouteData.Values["action"] ?? "Index").ToString();
    var titulo = ViewBag.Title != null ? ViewBag.Title + " | Gama SP Engenharia" : "Gama SP Engenharia | Engenharia Civil, Regularização e Obras em São Paulo";
    var descricao = ViewBag.Descricao ?? "Engenharia civil de alto padrão em São Paulo: regularização de imóveis, gerenciamento de obras, projetos, AVCB, SPDA, segurança do trabalho e retrofit de fachadas. Orçamento sem compromisso.";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@titulo</title>
    <meta name="description" content="@descricao" />
    <meta name="author" content="Gama SP Engenharia" />
    <meta name="theme-color" content="#1D2128" />
    <link rel="canonical" href="@urlAtual" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Gama SP Engenharia" />
    <meta property="og:title" content="@titulo" />
    <meta property="og:description" content="@descricao" />
    <meta property="og:image" content="@(urlBase)/images/gamasp/hero-obra-w.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="~/images/gamasp/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="~/images/gamasp/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Sora:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/Content/gamasp/gamasp.css?v=7" />

    <!-- Dados estruturados para o Google -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "GeneralContractor",
          "name": "Gama SP Engenharia",
          "description": "Engenharia civil, regularização de imóveis, gerenciamento de obras, projetos e segurança do trabalho em São Paulo.",
          "url": "@urlBase",
          "telephone": "+5511947430418",
          "email": "comercial@@gamaspengenharia.com.br",
          "areaServed": { "@@type": "State", "name": "São Paulo" },
          "address": { "@@type": "PostalAddress", "addressRegion": "SP", "addressCountry": "BR" },
          "openingHours": "Mo-Fr 08:00-17:00",
          "sameAs": [ "https://www.facebook.com/gamasp.engenharia" ],
          "founder": { "@@type": "Person", "name": "Eng. Cícero Gama", "jobTitle": "Engenheiro Civil e de Segurança do Trabalho" }
        }
    </script>
</head>
<body>

    <!-- ==================== Barra superior ==================== -->
    <div class="topbar">
        <div class="shell">
            <ul class="topbar-list">
                <li>
                    <a href="mailto:comercial@gamaspengenharia.com.br">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2 7 10 6 10-6" /></svg>
                        comercial@gamaspengenharia.com.br
                    </a>
                </li>
                <li>
                    <a href="tel:+5511947430418">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg>
                        (11) 94743-0418
                    </a>
                </li>
                <li>
                    <a href="#atendimento">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                        Seg. a Sex., 8h às 17h
                    </a>
                </li>
            </ul>

            <div class="topbar-social">
                <a href="https://www.facebook.com/gamasp.engenharia" target="_blank" rel="noopener" aria-label="Facebook da Gama SP Engenharia">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1Z" /></svg>
                </a>
                <a href="@waLink" target="_blank" rel="noopener" aria-label="WhatsApp da Gama SP Engenharia">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.5-.6a11.4 11.4 0 0 1-4.4-3.9c-.3-.5-.8-1.3-.8-2.5s.6-1.8.9-2c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 1.9c.1.1.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.5 1.9 1 .9 1.9 1.2 2.2 1.3.2.1.4.1.6-.1l.8-1c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.7-.1 1.2Z" /></svg>
                </a>
            </div>
        </div>
    </div>

    <!-- ==================== Cabeçalho ==================== -->
    <header class="site-header">
        <div class="shell">
            <a href="@Url.Action("Index", "Home")" class="brand" aria-label="Gama SP Engenharia — página inicial">
                @Html.Partial("_Marca", "header")
            </a>

            <nav class="nav" aria-label="Navegação principal">
                <ul class="nav-list">
                    <li><a class="nav-link @(acaoAtual == "Index" ? "is-active" : "")" href="@Url.Action("Index", "Home")">Início</a></li>
                    <li><a class="nav-link" href="@Url.Action("Index", "Home")#sobre">A Empresa</a></li>
                    <li><a class="nav-link @(acaoAtual == "Servicos" ? "is-active" : "")" href="@Url.Action("Servicos", "Home")">Serviços</a></li>
                    <li><a class="nav-link @(acaoAtual == "Galeria" ? "is-active" : "")" href="@Url.Action("Galeria", "Home")">Obras</a></li>
                    <li><a class="nav-link @(acaoAtual == "FaleConosco" ? "is-active" : "")" href="@Url.Action("FaleConosco", "Home")">Contato</a></li>
                </ul>
            </nav>

            <div class="header-cta">
                <a class="btn" href="@waLink" target="_blank" rel="noopener">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.5-.6a11.4 11.4 0 0 1-4.4-3.9c-.3-.5-.8-1.3-.8-2.5s.6-1.8.9-2c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 1.9c.1.1.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.5 1.9 1 .9 1.9 1.2 2.2 1.3.2.1.4.1.6-.1l.8-1c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.7-.1 1.2Z" /></svg>
                    Orçamento
                </a>

                <button class="burger" type="button" aria-expanded="false" aria-controls="menu-movel" aria-label="Abrir menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- Menu móvel -->
    <div class="mobile-nav" id="menu-movel">
        <ul>
            <li><a href="@Url.Action("Index", "Home")">Início</a></li>
            <li><a href="@Url.Action("Index", "Home")#sobre">A Empresa</a></li>
            <li><a href="@Url.Action("Servicos", "Home")">Serviços</a></li>
            <li><a href="@Url.Action("Galeria", "Home")">Obras</a></li>
            <li><a href="@Url.Action("FaleConosco", "Home")">Contato</a></li>
        </ul>
        <a class="btn btn--lg btn--block" href="@waLink" target="_blank" rel="noopener">
            Falar no WhatsApp
            <span class="btn-arrow">→</span>
        </a>
    </div>

    <main>
        @RenderBody()
    </main>

    <!-- ==================== Rodapé ==================== -->
    <footer class="site-footer">
        <div class="shell">
            <div class="footer-grid">
                <div class="footer-brand">
                    @Html.Partial("_Marca", "footer")
                    <p>Engenharia civil, regularização e gestão de obras em São Paulo. Parceria, comprometimento com prazos e resultados fazem parte do nosso DNA.</p>
                </div>

                <div class="footer-col">
                    <h4>Navegação</h4>
                    <ul>
                        <li><a href="@Url.Action("Index", "Home")">Início</a></li>
                        <li><a href="@Url.Action("Index", "Home")#sobre">A Empresa</a></li>
                        <li><a href="@Url.Action("Servicos", "Home")">Serviços</a></li>
                        <li><a href="@Url.Action("Galeria", "Home")">Obras</a></li>
                        <li><a href="@Url.Action("FaleConosco", "Home")">Contato</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Serviços</h4>
                    <ul>
                        <li><a href="@Url.Action("Servicos", "Home")#regularizacao">Regularização de imóveis</a></li>
                        <li><a href="@Url.Action("Servicos", "Home")#gerenciamento">Gerenciamento de obras</a></li>
                        <li><a href="@Url.Action("Servicos", "Home")#projetos">Projetos e aprovações</a></li>
                        <li><a href="@Url.Action("Servicos", "Home")#avcb">AVCB e prevenção</a></li>
                        <li><a href="@Url.Action("Servicos", "Home")#spda">SPDA</a></li>
                        <li><a href="@Url.Action("Servicos", "Home")#fachadas">Retrofit de fachadas</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Responsável Técnico</h4>
                    <div class="footer-creds">
                        <div><b>Razão social:</b> <span>Gama SP Engenharia</span></div>
                        <div><b>CNPJ:</b> <span>12.737.657/0001-15</span></div>
                        <div><b>CREA empresa:</b> <span>2223278</span></div>
                        <div><b>Engenheiro:</b> <span>Cícero Gama — CREA 5070392074</span></div>
                        <div><b>Ordem dos Eng. de Portugal:</b> <span>Região Sul nº 92650</span></div>
                        <div><b>Titulação:</b> <span>Eng. Civil · Eng. de Segurança do Trabalho · Eng. de Avaliações e Perícias</span></div>
                        <div><b>Atendimento:</b> <span>Seg. a Sex., 8h às 17h</span></div>
                    </div>
                </div>
            </div>

            <div class="footer-bar">
                <span>&copy; <span data-year>2026</span> Gama SP Engenharia. Todos os direitos reservados.</span>
                <span>
                    <a href="mailto:comercial@gamaspengenharia.com.br">comercial@gamaspengenharia.com.br</a>
                    &nbsp;·&nbsp;
                    <a href="tel:+5511947430418">(11) 94743-0418</a>
                </span>
            </div>
        </div>
    </footer>

    <!-- Botão flutuante do WhatsApp -->
    <a class="wa-float" href="@waLink" target="_blank" rel="noopener" aria-label="Falar com a Gama SP Engenharia no WhatsApp">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.5-.6a11.4 11.4 0 0 1-4.4-3.9c-.3-.5-.8-1.3-.8-2.5s.6-1.8.9-2c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 1.9c.1.1.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.5 1.9 1 .9 1.9 1.2 2.2 1.3.2.1.4.1.6-.1l.8-1c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.7-.1 1.2Z" /></svg>
        <b>Fale conosco</b>
    </a>

    <script src="~/Scripts/gamasp/gamasp.js?v=7"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
